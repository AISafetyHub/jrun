# Service account (the key that may submit to the public pool).
AIRS_AK=
AIRS_SK=

# Required: project sets (names) the service submits into. The service
# account must be a member; callers must be members too.
JRUN_SERVE_PROJECT_SETS=baai-safety

# Optional: only these caller aliases may use the service (comma-separated).
JRUN_SERVE_USERS=

# Optional: queue categories the service submits (default: public).
# JRUN_SERVE_CATEGORIES=public

# Optional: default airsctl project context / gateway.
# JRUN_AIRSCTL_GATEWAY=http://platform-multi.baai.ac.cn
# JRUN_AIRSCTL_PROJSET_ID=
# JRUN_AIRSCTL_PROJ_ID=

# Optional: host port for docker compose (container listens on 8080).
# JRUN_SERVE_PUBLISH=8080
